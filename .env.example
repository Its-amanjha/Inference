# Environment variables are read from the process; .env is a reference, not auto-loaded.
INFERENCE_DATA_DIR=data
INFERENCE_SECURE_COOKIES=true
INFERENCE_SESSION_HOURS=12
INFERENCE_MAX_REQUEST_BYTES=2097152
# Exact comma-separated browser origins. Empty means the request's own origin.
INFERENCE_ALLOWED_ORIGINS=
# Explicit private fleet networks. Metadata and reserved targets remain blocked.
INFERENCE_EGRESS_ALLOW_CIDRS=
# Required to create the first administrator remotely; choose a random value.
INFERENCE_BOOTSTRAP_TOKEN=
# Docker manager uses this Unix socket only; Docker Desktop named pipes are not used.
INFERENCE_DOCKER_SOCKET=/var/run/docker.sock
