# Inference configuration. Copy to .env and adjust.
# The application reads these from the process environment only. scripts/run_local.py loads .env
# for you; with Docker Compose, set them in the environment or a Compose env file.
# Legacy VECTIS_* names are still read when the INFERENCE_* name is absent.

# --- Launcher (used by scripts/run_local.py only, not by the application) -----------------------
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=3000

# --- Storage ---------------------------------------------------------------------------------
# SQLite database, encrypted secret vault, notes and backups live here. Never commit this folder.
INFERENCE_DATA_DIR=data

# --- Sessions and browser access ----------------------------------------------------------------
# true behind HTTPS. Set false only for plain-http local development.
INFERENCE_SECURE_COOKIES=true
# Lifetime of new sessions in hours (1-168). When set here, the Settings page cannot change it.
INFERENCE_SESSION_HOURS=12
# Largest accepted request body in bytes.
INFERENCE_MAX_REQUEST_BYTES=2097152
# Exact comma-separated browser origins, e.g. https://inference.example.com. Empty means the
# request's own origin.
INFERENCE_ALLOWED_ORIGINS=

# --- Outbound network (SSRF guard) ------------------------------------------------------------
# Public addresses are always allowed. Private, loopback and LAN destinations (local n8n, Ollama,
# MCP servers) must be listed as CIDRs, comma-separated, e.g. 127.0.0.1/32,192.168.1.0/24.
# Cloud metadata and reserved addresses stay blocked regardless.
INFERENCE_EGRESS_ALLOW_CIDRS=

# --- First administrator ----------------------------------------------------------------------
# Empty: the first administrator can only be created from this machine (loopback).
# Set: every setup request, local ones included, must send it in the X-Inference-Bootstrap header.
# Required when the first administrator is created remotely, for example in Docker. Use a long random value.
INFERENCE_BOOTSTRAP_TOKEN=

# --- Docker manager -------------------------------------------------------------------------
# Unix socket only; Docker Desktop named pipes are not used.
INFERENCE_DOCKER_SOCKET=/var/run/docker.sock

# --- Related settings outside Inference ------------------------------------------------------
# Ollama reads its own variables, set them for the Ollama process, not here:
#   OLLAMA_CONTEXT_LENGTH=8192   so a skill guide fits in the prompt (see docs/api-assistant.md)
